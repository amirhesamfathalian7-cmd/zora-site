{
  "name": "zora-reader",
  "productName": "ZORA Reader",
  "version": "2.4.0",
  "description": "کتاب‌خوان هوشمند مدارس ایران — zora reader",
  "author": "zora team — ZAK & AXORA",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^26.0.12",
    "pdfjs-dist": "3.11.174",
    "resedit": "^2.0.3"
  },
  "dependencies": {
    "adm-zip": "0.5.16"
  },
  "build": {
    "appId": "ir.zora.reader",
    "productName": "ZORA Reader",
    "afterPack": "scripts/afterpack.js",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "books/**",
      "package.json"
    ],
    "asarUnpack": [
      "books/**"
    ],
    "compression": "store",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "zora reader",
      "artifactName": "ZORA-Reader-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "useZip": true,
      "artifactName": "ZORA-Reader-Portable-${version}.exe"
    }
  },
  "allowScripts": {
    "electron@22.3.27": true
  }
}
